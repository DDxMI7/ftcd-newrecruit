<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<catalogue id="nsc-cat-0001" name="New Swabian League (NSC)"
           revision="1" battleScribeVersion="2.03"
           gameSystemId="ftcd-0001-gs01"
           gameSystemRevision="1"
           authorName="" authorContact="" authorUrl=""
           xmlns="http://www.battlescribe.net/schema/catalogueSchema">

  <readme>New Swabian League fleet catalogue for Full Thrust Cross Dimensions.
Standard FTCD ship classes and systems. WIP — weapon options being expanded.</readme>

  <publications>
    <publication id="pub-ftcd-nsc-0001" name="Full Thrust Cross Dimensions"
                 shortName="FTCD" publisher="Ground Zero Games"
                 publicationDate="2010" publisherUrl="http://groundzerogames.net"/>
  </publications>

  <!-- ═══════════════════════════════════════════════════════════
       SHARED SYSTEM ENTRIES
       (will be extracted to library catalogue in a later revision)
       ═══════════════════════════════════════════════════════════ -->
  <sharedSelectionEntries>

    <!-- ── DRIVES ── -->
    <selectionEntry id="sys-drive-t2-0001" name="Drive (Thrust 2)" type="upgrade" hidden="false" collective="false" import="true">
      <profiles>
        <profile id="prof-drive-t2-0001" name="Drive (Thrust 2)" typeId="pt-weapon-0001" typeName="Weapon System">
          <characteristics>
            <characteristic name="Class" typeId="ct-wclass-0001">Drive</characteristic>
            <characteristic name="Max Range (MU)" typeId="ct-range-0001">—</characteristic>
            <characteristic name="Damage Dice" typeId="ct-wdice-0001">—</characteristic>
            <characteristic name="Fire Arcs" typeId="ct-arcs-0001">—</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <costs>
        <cost name="pts"  typeId="cost-pts-0001"  value="6"/>
        <cost name="Mass" typeId="cost-mass-0001" value="1"/>
      </costs>
      <categoryLinks>
        <categoryLink id="cl-drive-t2-0001" name="Drive" hidden="false" targetId="cat-drive-0001" primary="true"/>
      </categoryLinks>
    </selectionEntry>

    <selectionEntry id="sys-drive-t4-0001" name="Drive (Thrust 4)" type="upgrade" hidden="false" collective="false" import="true">
      <costs>
        <cost name="pts"  typeId="cost-pts-0001"  value="10"/>
        <cost name="Mass" typeId="cost-mass-0001" value="2"/>
      </costs>
      <categoryLinks>
        <categoryLink id="cl-drive-t4-0001" name="Drive" hidden="false" targetId="cat-drive-0001" primary="true"/>
      </categoryLinks>
    </selectionEntry>

    <selectionEntry id="sys-drive-t6-0001" name="Drive (Thrust 6)" type="upgrade" hidden="false" collective="false" import="true">
      <costs>
        <cost name="pts"  typeId="cost-pts-0001"  value="14"/>
        <cost name="Mass" typeId="cost-mass-0001" value="3"/>
      </costs>
      <categoryLinks>
        <categoryLink id="cl-drive-t6-0001" name="Drive" hidden="false" targetId="cat-drive-0001" primary="true"/>
      </categoryLinks>
    </selectionEntry>

    <selectionEntry id="sys-drive-t8-0001" name="Drive (Thrust 8)" type="upgrade" hidden="false" collective="false" import="true">
      <costs>
        <cost name="pts"  typeId="cost-pts-0001"  value="18"/>
        <cost name="Mass" typeId="cost-mass-0001" value="4"/>
      </costs>
      <categoryLinks>
        <categoryLink id="cl-drive-t8-0001" name="Drive" hidden="false" targetId="cat-drive-0001" primary="true"/>
      </categoryLinks>
    </selectionEntry>

    <!-- ── FIRECONS ── -->
    <selectionEntry id="sys-firecon-0001" name="Fire Control System" type="upgrade" hidden="false" collective="false" import="true">
      <rules>
        <rule id="rule-firecon-0001" name="Fire Control System" publicationId="pub-ftcd-nsc-0001"
              description="Each firecon allows the ship to fire one weapon system per turn. You need 1 firecon per 3 beam batteries (round up)."/>
      </rules>
      <costs>
        <cost name="pts"  typeId="cost-pts-0001"  value="4"/>
        <cost name="Mass" typeId="cost-mass-0001" value="1"/>
      </costs>
    </selectionEntry>

    <!-- ── BEAM BATTERIES ── -->
    <selectionEntry id="sys-beam1-0001" name="Beam Battery Class 1" type="upgrade" hidden="false" collective="false" import="true">
      <profiles>
        <profile id="prof-beam1-0001" name="Beam Battery Class 1" typeId="pt-weapon-0001" typeName="Weapon System">
          <characteristics>
            <characteristic name="Class"          typeId="ct-wclass-0001">1</characteristic>
            <characteristic name="Max Range (MU)"  typeId="ct-range-0001">12</characteristic>
            <characteristic name="Damage Dice"     typeId="ct-wdice-0001">1d6</characteristic>
            <characteristic name="Fire Arcs"       typeId="ct-arcs-0001">Any 3 arcs</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="rule-beam1-0001" name="Beam Class 1" publicationId="pub-ftcd-nsc-0001"
              description="Fires 1d6 at 0–12 MU. Penetrating on a 6 (re-roll, extra damage bypasses screens/armour)."/>
      </rules>
      <costs>
        <cost name="pts"  typeId="cost-pts-0001"  value="3"/>
        <cost name="Mass" typeId="cost-mass-0001" value="1"/>
      </costs>
      <categoryLinks>
        <categoryLink id="cl-beam1-0001" name="Weapon System" hidden="false" targetId="cat-weapon-0001" primary="true"/>
      </categoryLinks>
    </selectionEntry>

    <selectionEntry id="sys-beam2-0001" name="Beam Battery Class 2" type="upgrade" hidden="false" collective="false" import="true">
      <profiles>
        <profile id="prof-beam2-0001" name="Beam Battery Class 2" typeId="pt-weapon-0001" typeName="Weapon System">
          <characteristics>
            <characteristic name="Class"          typeId="ct-wclass-0001">2</characteristic>
            <characteristic name="Max Range (MU)"  typeId="ct-range-0001">24</characteristic>
            <characteristic name="Damage Dice"     typeId="ct-wdice-0001">2d6</characteristic>
            <characteristic name="Fire Arcs"       typeId="ct-arcs-0001">Any 3 arcs</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <costs>
        <cost name="pts"  typeId="cost-pts-0001"  value="6"/>
        <cost name="Mass" typeId="cost-mass-0001" value="2"/>
      </costs>
      <categoryLinks>
        <categoryLink id="cl-beam2-0001" name="Weapon System" hidden="false" targetId="cat-weapon-0001" primary="true"/>
      </categoryLinks>
    </selectionEntry>

    <selectionEntry id="sys-beam3-0001" name="Beam Battery Class 3" type="upgrade" hidden="false" collective="false" import="true">
      <profiles>
        <profile id="prof-beam3-0001" name="Beam Battery Class 3" typeId="pt-weapon-0001" typeName="Weapon System">
          <characteristics>
            <characteristic name="Class"          typeId="ct-wclass-0001">3</characteristic>
            <characteristic name="Max Range (MU)"  typeId="ct-range-0001">36</characteristic>
            <characteristic name="Damage Dice"     typeId="ct-wdice-0001">3d6</characteristic>
            <characteristic name="Fire Arcs"       typeId="ct-arcs-0001">Any 3 arcs</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <costs>
        <cost name="pts"  typeId="cost-pts-0001"  value="9"/>
        <cost name="Mass" typeId="cost-mass-0001" value="3"/>
      </costs>
      <categoryLinks>
        <categoryLink id="cl-beam3-0001" name="Weapon System" hidden="false" targetId="cat-weapon-0001" primary="true"/>
      </categoryLinks>
    </selectionEntry>

    <!-- ── SCREENS ── -->
    <selectionEntry id="sys-screen1-0001" name="Defensive Screen Level 1" type="upgrade" hidden="false" collective="false" import="true">
      <constraints>
        <constraint id="con-screen1-max-0001" type="max" value="1" field="selections" scope="parent" shared="false"/>
      </constraints>
      <rules>
        <rule id="rule-screen1-0001" name="Screen Level 1" publicationId="pub-ftcd-nsc-0001"
              description="Subtracts 1 from each damage die result. Cannot reduce below 1."/>
      </rules>
      <costs>
        <cost name="pts"  typeId="cost-pts-0001"  value="6"/>
        <cost name="Mass" typeId="cost-mass-0001" value="1"/>
      </costs>
      <categoryLinks>
        <categoryLink id="cl-screen1-0001" name="Screen" hidden="false" targetId="cat-screen-0001" primary="true"/>
      </categoryLinks>
    </selectionEntry>

    <selectionEntry id="sys-screen2-0001" name="Defensive Screen Level 2" type="upgrade" hidden="false" collective="false" import="true">
      <constraints>
        <constraint id="con-screen2-max-0001" type="max" value="1" field="selections" scope="parent" shared="false"/>
      </constraints>
      <rules>
        <rule id="rule-screen2-0001" name="Screen Level 2" publicationId="pub-ftcd-nsc-0001"
              description="Subtracts 2 from each damage die result. Cannot reduce below 1."/>
      </rules>
      <costs>
        <cost name="pts"  typeId="cost-pts-0001"  value="12"/>
        <cost name="Mass" typeId="cost-mass-0001" value="2"/>
      </costs>
      <categoryLinks>
        <categoryLink id="cl-screen2-0001" name="Screen" hidden="false" targetId="cat-screen-0001" primary="true"/>
      </categoryLinks>
    </selectionEntry>

    <!-- ── PDS ── -->
    <selectionEntry id="sys-pds-0001" name="Point Defence System (PDS)" type="upgrade" hidden="false" collective="false" import="true">
      <rules>
        <rule id="rule-pds-0001" name="PDS" publicationId="pub-ftcd-nsc-0001"
              description="Intercepts fighters and missiles. Each PDS rolls 1d6 on a 4+ to destroy an incoming attack."/>
      </rules>
      <costs>
        <cost name="pts"  typeId="cost-pts-0001"  value="3"/>
        <cost name="Mass" typeId="cost-mass-0001" value="1"/>
      </costs>
      <categoryLinks>
        <categoryLink id="cl-pds-0001" name="PDS" hidden="false" targetId="cat-pds-0001" primary="true"/>
      </categoryLinks>
    </selectionEntry>

  </sharedSelectionEntries>

  <!-- ═══════════════════════════════════════════════════════════
       SHIP CLASSES
       Available mass = Hull Mass - Structural Mass - Drive Mass
       Structural Mass = ceil(Hull Points / 2)
       Drive Mass      = ceil(Thrust / 2)
       ═══════════════════════════════════════════════════════════ -->
  <selectionEntries>

    <!-- CORVETTE  Mass 10 | Hull 3 | Thrust 6 | Structural 2 | Drive 3 | Available 5 -->
    <selectionEntry id="nsc-corvette-0001" name="NSC Corvette" type="unit" hidden="false" collective="false" import="true">
      <profiles>
        <profile id="prof-nsc-corvette-0001" name="NSC Corvette" typeId="pt-shipstats-0001" typeName="Ship Stats">
          <characteristics>
            <characteristic name="Thrust Rating"  typeId="ct-thrust-0001">6</characteristic>
            <characteristic name="Hull Points"    typeId="ct-hull-0001">3</characteristic>
            <characteristic name="Firecons"       typeId="ct-firecons-0001">1</characteristic>
            <characteristic name="Screen Level"   typeId="ct-screen-0001">0</characteristic>
            <characteristic name="Armour Grade"   typeId="ct-armour-0001">0</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <constraints>
        <!-- Mass budget: max 5 mass of optional systems -->
        <constraint id="con-corvette-mass-0001" type="max" value="5"
                    field="Mass" scope="self" shared="false" includeChildSelections="true"/>
      </constraints>
      <costs>
        <cost name="pts"  typeId="cost-pts-0001"  value="0"/>
        <cost name="Mass" typeId="cost-mass-0001" value="0"/>
      </costs>
      <categoryLinks>
        <categoryLink id="cl-corvette-ship-0001" name="Ship" hidden="false" targetId="cat-ship-0001" primary="true"/>
      </categoryLinks>
      <selectionEntries>
        <!-- Mandatory Drive -->
        <selectionEntry id="nsc-corvette-drive-0001" name="Drive (Thrust 6)" type="upgrade" hidden="false" collective="false" import="true">
          <constraints>
            <constraint id="con-corvette-drive-min-0001" type="min" value="1" field="selections" scope="parent" shared="false"/>
            <constraint id="con-corvette-drive-max-0001" type="max" value="1" field="selections" scope="parent" shared="false"/>
          </constraints>
          <costs>
            <cost name="pts"  typeId="cost-pts-0001"  value="14"/>
            <cost name="Mass" typeId="cost-mass-0001" value="3"/>
          </costs>
        </selectionEntry>
        <!-- Mandatory Firecon -->
        <selectionEntry id="nsc-corvette-firecon-0001" name="Fire Control System" type="upgrade" hidden="false" collective="false" import="true">
          <constraints>
            <constraint id="con-corvette-fc-min-0001" type="min" value="1" field="selections" scope="parent" shared="false"/>
            <constraint id="con-corvette-fc-max-0001" type="max" value="1" field="selections" scope="parent" shared="false"/>
          </constraints>
          <costs>
            <cost name="pts"  typeId="cost-pts-0001"  value="4"/>
            <cost name="Mass" typeId="cost-mass-0001" value="1"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
      <selectionEntryGroups>
        <selectionEntryGroup id="seg-corvette-weapons-0001" name="Weapons" hidden="false" collective="false" import="true">
          <selectionEntryLinks>
            <selectionEntryLink id="sel-corvette-beam1-0001" name="Beam Battery Class 1" hidden="false" collective="false" import="true" targetId="sys-beam1-0001"/>
            <selectionEntryLink id="sel-corvette-beam2-0001" name="Beam Battery Class 2" hidden="false" collective="false" import="true" targetId="sys-beam2-0001"/>
          </selectionEntryLinks>
        </selectionEntryGroup>
        <selectionEntryGroup id="seg-corvette-defence-0001" name="Defensive Systems" hidden="false" collective="false" import="true">
          <selectionEntryLinks>
            <selectionEntryLink id="sel-corvette-screen1-0001" name="Screen Level 1" hidden="false" collective="false" import="true" targetId="sys-screen1-0001"/>
            <selectionEntryLink id="sel-corvette-pds-0001" name="PDS" hidden="false" collective="false" import="true" targetId="sys-pds-0001"/>
          </selectionEntryLinks>
        </selectionEntryGroup>
      </selectionEntryGroups>
    </selectionEntry>

    <!-- FRIGATE  Mass 12 | Hull 4 | Thrust 6 | Structural 2 | Drive 3 | Available 7 -->
    <selectionEntry id="nsc-frigate-0001" name="NSC Frigate" type="unit" hidden="false" collective="false" import="true">
