            <selectionEntryLink id="sel-frigate-pds-0001" name="PDS" hidden="false" collective="false" import="true" targetId="sys-pds-0001"/>
          </selectionEntryLinks>
        </selectionEntryGroup>
      </selectionEntryGroups>
    </selectionEntry>

    <!-- DESTROYER  Mass 18 | Hull 6 | Thrust 6 | Structural 3 | Drive 3 | Available 12 -->
    <selectionEntry id="nsc-destroyer-0001" name="NSC Destroyer" type="unit" hidden="false" collective="false" import="true">
