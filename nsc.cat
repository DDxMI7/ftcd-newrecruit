          </costs>
        </selectionEntry>
      </selectionEntries>
      <selectionEntryGroups>
        <selectionEntryGroup id="seg-frigate-weapons-0001" name="Weapons" hidden="false" collective="false" import="true">
          <selectionEntryLinks>
            <selectionEntryLink id="sel-frigate-beam1-0001" name="Beam Battery Class 1" hidden="false" collective="false" import="true" targetId="sys-beam1-0001"/>
            <selectionEntryLink id="sel-frigate-beam2-0001" name="Beam Battery Class 2" hidden="false" collective="false" import="true" targetId="sys-beam2-0001"/>
            <selectionEntryLink id="sel-frigate-beam3-0001" name="Beam Battery Class 3" hidden="false" collective="false" import="true" targetId="sys-beam3-0001"/>
          </selectionEntryLinks>
        </selectionEntryGroup>
        <selectionEntryGroup id="seg-frigate-defence-0001" name="Defensive Systems" hidden="false" collective="false" import="true">
          <selectionEntryLinks>
